@* Vỏ trình bày cho các filter do page cung cấp; component không chứa business filter hoặc tự query SQL. *@
<MudPaper Class="oee-page-filter pa-3 mb-3" Elevation="0"
          Outlined="true">
    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.End" Spacing="1">
        @ChildContent
    </MudStack>
</MudPaper>
