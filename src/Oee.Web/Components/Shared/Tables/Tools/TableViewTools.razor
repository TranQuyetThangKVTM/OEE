@namespace Oee.Web.Components.Shared
@implements IAsyncDisposable
@inject IJSRuntime JS

<MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Class="table-view-tools">
    <MudMenu Label="Cột" StartIcon="@Icons.Material.Filled.Tune" Variant="Variant.Text" Color="Color.Default"
             Size="Size.Small" Dense="true" AnchorOrigin="Origin.BottomRight"
             TransformOrigin="Origin.TopRight" AriaLabel="Hiển thị cột" title="Hiển thị cột" Disabled="@(_module is null)">
        <ChildContent>
        <MudPaper Class="column-settings" Elevation="0">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="px-3 py-1">
                <MudText Typo="Typo.subtitle2">Hiển thị cột</MudText>
                <MudButton Size="Size.Small" OnClick="ShowAllAsync">Hiện tất cả</MudButton>
            </MudStack>
            <MudDivider />
            <MudStack Spacing="0" Class="column-settings-list">
                @foreach (var column in _columns)
                {
                    <MudCheckBox T="bool" Value="@column.Visible" ValueChanged="value => SetVisibleAsync(column, value)"
                                 Label="@column.Label" Dense="true" Size="Size.Small" Color="Color.Primary"
                                 Disabled="@(column.Visible && _columns.Count(item => item.Visible) == 1)" />
                }
            </MudStack>
        </MudPaper>
        </ChildContent>
    </MudMenu>
</MudStack>
@if (_error is not null)
{ <MudAlert Severity="Severity.Warning" Dense="true">@_error</MudAlert> }

@code {
    [Parameter, EditorRequired] public string TableId { get; set; } = string.Empty;
    [Parameter] public string Title { get; set; } = "Dữ liệu bảng";
    private IJSObjectReference? _module;
    private DotNetObjectReference<TableViewTools>? _reference;
    private TableViewColumn[] _columns = [];
    private string? _error;
    private bool _failed;
    private bool _disposed;
    private bool _connecting;
    private string? _connectedTableId;
    private string? _connectedTitle;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_failed || _disposed || _connecting
            || (_connectedTableId == TableId && _connectedTitle == Title)) return;
        _connecting = true;
        try
        {
            var initialized = _module is null;
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./" + Assets["table-tools.js"]);
            if (_module is null) return;
            if (_disposed) { await _module.DisposeAsync(); return; }
            _reference ??= DotNetObjectReference.Create(this);
            if (_connectedTableId is not null)
                await _module.InvokeVoidAsync("disconnect", _connectedTableId);
            var columns = await _module.InvokeAsync<TableViewColumn[]?>("connect", TableId, Title, _reference);
            if (columns is not null)
            {
                _connectedTableId = TableId;
                _connectedTitle = Title;
            }
            if (columns is not null && !columns.SequenceEqual(_columns))
            {
                _columns = columns;
                StateHasChanged();
            }
            else if (initialized) StateHasChanged();
        }
        catch (JSDisconnectedException) { }
        catch (JSException)
        {
            _failed = true;
            _error = "Chưa tải được công cụ bảng. Hãy tải lại trang để thử lại.";
            if (!_disposed) StateHasChanged();
        }
        finally { _connecting = false; }
    }

    [JSInvokable]
    public Task UpdateColumns(TableViewColumn[] columns) => InvokeAsync(() =>
    {
        if (_disposed || columns.SequenceEqual(_columns)) return;
        _columns = columns;
        StateHasChanged();
    });

    private async Task SetVisibleAsync(TableViewColumn column, bool visible)
    {
        if (_module is null) return;
        try { _columns = await _module.InvokeAsync<TableViewColumn[]>("setVisible", TableId, column.Key, visible); }
        catch (JSDisconnectedException) { }
    }

    private async Task ShowAllAsync()
    {
        if (_module is null) return;
        try { _columns = await _module.InvokeAsync<TableViewColumn[]>("showAll", TableId); }
        catch (JSDisconnectedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _reference?.Dispose();
        if (_module is null) return;
        try
        {
            if (_connectedTableId is not null) await _module.InvokeVoidAsync("disconnect", _connectedTableId);
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }
}
