@namespace Oee.Web.Components.Pages.Reports
@using System.Globalization
@using Oee.Application.Contracts.Reporting
@using Oee.Application.Reporting
@inject IDialogService DialogService

<MudPaper Class="equipment-timeline pa-4 mb-3" Outlined="true" Elevation="0">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Spacing="2" Class="mb-2">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudIcon Icon="@Icons.Material.Filled.Timeline" Color="Color.Primary" Size="Size.Small" />
            <MudText Typo="Typo.subtitle1" Class="kpi-emphasis">@Title</MudText>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@Data.Rows.Count thiết bị</MudChip>
        </MudStack>
        <MudChip T="string" Color="Color.Error" Variant="Variant.Outlined" Size="Size.Small">@Data.Rows.Sum(x => x.StopCount) lần · @EquipmentTimeText.Duration(StopMinutes)</MudChip>
    </MudStack>
    <MudText Typo="Typo.caption" Class="kpi-muted">Chọn một đoạn để xem thời gian và lý do. Ưu tiên lịch sử trạng thái PLC; dùng khoảng sản lượng khi chưa có lịch sử. Khoảng thiếu dữ liệu hiển thị riêng.</MudText>
    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="equipment-legend my-3">
        @foreach (var state in Legend)
        {
            <MudChip T="string" Size="Size.Small" Class="@($"equipment-legend--{state}")" Variant="Variant.Outlined">@EquipmentTimeText.State(state)</MudChip>
        }
    </MudStack>
    @if (Data.Rows.Count == 0)
    { <EmptyState Title="Không có thiết bị trong phạm vi" /> }
    else
    {
        <MudPaper Elevation="0" Class="equipment-timeline-scroll">
            <MudPaper Elevation="0" Class="equipment-time-axis equipment-timeline-row">
                <MudText Typo="Typo.caption" Class="kpi-muted">Thiết bị</MudText>
                <MudPaper Elevation="0" Class="equipment-axis-track">
                    @for (var tick = 0; tick <= 8; tick++)
                    {
                        var time = Data.Start.AddTicks((Data.End - Data.Start).Ticks * tick / 8);
                        <MudText Typo="Typo.caption" Class="equipment-axis-label" Style="@($"left:{(tick * 12.5).ToString(CultureInfo.InvariantCulture)}%")">@AxisLabel(time)</MudText>
                    }
                </MudPaper>
            </MudPaper>
            @foreach (var row in Data.Rows)
            {
                <MudPaper Class="equipment-timeline-row" Elevation="0">
                    <MudStack Spacing="0">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudText Typo="Typo.body2" Class="kpi-emphasis">@row.Code</MudText>
                            @if (row.StopCount > 0) { <MudChip T="string" Size="Size.Small" Color="Color.Error">@row.StopCount</MudChip> }
                        </MudStack>
                        <MudText Typo="Typo.caption" Class="kpi-muted">@row.Name</MudText>
                    </MudStack>
                    <MudPaper Elevation="0" Class="equipment-track" role="group" aria-label="@($"Dòng thời gian {row.Code}")">
                        @foreach (var segment in row.Segments)
                        {
                            <MudTooltip Text="@Tooltip(segment)" RootClass="@($"equipment-segment equipment-segment--{segment.State}")" RootStyle="@Position(segment)" Inline="false">
                                <MudButton Variant="Variant.Text" Class="equipment-segment-button" aria-label="@($"{row.Code}: {Tooltip(segment)}")"
                                           OnClick="() => ShowAsync(row, segment)" />
                            </MudTooltip>
                        }
                    </MudPaper>
                </MudPaper>
            }
        </MudPaper>
    }
</MudPaper>
