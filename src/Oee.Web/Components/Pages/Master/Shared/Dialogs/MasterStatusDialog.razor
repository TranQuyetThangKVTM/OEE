@namespace Oee.Web.Components.Pages.Master
@using Oee.Application.Contracts.Modules
@using Oee.Application.Contracts.Operations
@inject Oee.Application.Modules.IMasterDataQueryService Query
@inject Oee.Application.Common.IUseCaseExecutor Commands
@inject IAuthorizationService Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ISnackbar Snackbar

@* Dialog tạm ngưng/kích hoạt lại master data. Nó tải Code/Name/Status/RowVersion mới nhất theo Id,
   không hard-delete và không tự cascade sang con. Backend chặn parent inactive/dependency active theo rule. *@
<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">@ActionTitle</MudText></TitleContent>
    <DialogContent>
        @if (_loading) { <MudStack AlignItems="AlignItems.Center" Class="pa-5"><MudProgressCircular Indeterminate="true" /></MudStack> }
        else if (!string.IsNullOrWhiteSpace(_error)) { <MudAlert Severity="Severity.Error">@_error</MudAlert> }
        else
        {
            <MudAlert Class="mb-3"
                      Severity="@(_targetStatus == "Inactive" ? Severity.Warning : Severity.Info)">
                Trạng thái không được tự động cascade xuống dữ liệu con.
            </MudAlert>
            <MudGrid>
                <MudItem xs="4"><MudText Typo="Typo.caption">Mã</MudText></MudItem><MudItem xs="8"><MudText><strong>@_code</strong></MudText></MudItem>
                <MudItem xs="4"><MudText Typo="Typo.caption">Tên</MudText></MudItem><MudItem xs="8"><MudText>@_name</MudText></MudItem>
                <MudItem xs="4"><MudText Typo="Typo.caption">Hiện tại</MudText></MudItem><MudItem xs="8"><StatusChip Text="@_currentStatus" Kind="@(_currentStatus == "Active" ? SemanticKind.Success : SemanticKind.Warning)" /></MudItem>
                <MudItem xs="4"><MudText Typo="Typo.caption">Sau thao tác</MudText></MudItem><MudItem xs="8"><StatusChip Text="@_targetStatus" Kind="@(_targetStatus == "Active" ? SemanticKind.Success : SemanticKind.Warning)" /></MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Disabled="_saving"
                   OnClick="Cancel">Hủy</MudButton>
        <MudButton Variant="Variant.Filled" Color="@(_targetStatus == "Active" ? Color.Success : Color.Warning)"
                   Disabled="@(_loading || _saving || !string.IsNullOrWhiteSpace(_error))"
                   OnClick="ConfirmAsync">
            @if (_saving) { <MudProgressCircular Size="Size.Small" Class="mr-2"
                                 Indeterminate="true" /> }
            @(_targetStatus == "Active" ? "Kích hoạt lại" : "Tạm ngưng")
        </MudButton>
    </DialogActions>
</MudDialog>
