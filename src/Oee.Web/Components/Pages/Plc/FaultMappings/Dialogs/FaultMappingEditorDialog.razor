@namespace Oee.Web.Components.Pages.Plc
@using Oee.Application.Contracts.Modules
@using Oee.Application.Contracts.PlcIntegration
@inject Oee.Application.Common.IUseCaseExecutor Plc
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService Authorization
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider Authentication

<MudDialog>
 <TitleContent><MudText Typo="Typo.h6">@Title</MudText></TitleContent>
 <DialogContent>
  <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">Mapping riêng thiết bị được ưu tiên trước mapping toàn cục.</MudAlert>
  @if (!string.IsNullOrWhiteSpace(_error)) { <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-3">@_error</MudAlert> }
  <MudForm @ref="_mudForm" @bind-IsValid="_valid">
   <MudStack Spacing="3" Class="py-2"><MudGrid Spacing="3">
 <MudItem xs="12" sm="6"><MudSelect T="string" @bind-Value="_form.WorkUnitId" Label="Scope" Clearable="true" HelperText="Để trống để áp dụng toàn cục">
  @foreach (PlcLookup workUnit in Lookups?.WorkUnits ?? []) { <MudSelectItem Value="@workUnit.Id.ToString()">@workUnit.Code — @workUnit.Name</MudSelectItem> }
 </MudSelect></MudItem>
 <MudItem xs="12" sm="6"><MudTextField @bind-Value="_form.FaultCode" Label="Fault code" Required="true" /></MudItem>
 <MudItem xs="12"><MudSelect T="string" @bind-Value="_form.ReasonId" Label="Downtime reason" Required="true">
  @foreach (PlcLookup reason in Lookups?.DowntimeReasons ?? []) { <MudSelectItem Value="@reason.Id.ToString()">@reason.Code — @reason.Name</MudSelectItem> }
 </MudSelect></MudItem>
 <MudItem xs="12"><MudTextField @bind-Value="_form.Description" Label="Mô tả" Lines="3" /></MudItem>
 <MudItem xs="12"><MudCheckBox T="bool" @bind-Value="_form.Active" Label="Active" /></MudItem>
</MudGrid></MudStack>
  </MudForm>
 </DialogContent>
 <DialogActions>
  <MudButton OnClick="Cancel" Disabled="_saving">Hủy</MudButton>
  <AuthorizeAction Policy="@Capabilities.PlcManage">
   <MudButton OnClick="SaveAsync" Disabled="_saving" Variant="Variant.Filled" Color="Color.Primary">Lưu</MudButton>
  </AuthorizeAction>
 </DialogActions>
</MudDialog>
