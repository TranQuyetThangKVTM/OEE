@namespace Oee.Web.Components.Pages.Production
@page "/production/plan-templates/{Id:guid}"
@using Oee.Application.Contracts.Modules
@attribute [Authorize]
@inject Oee.Application.Modules.IProductionModuleQueryService Query
@inject Oee.Application.Common.IUseCaseExecutor Commands
@inject IDialogService DialogService

<PageTitle>Chi tiết kế hoạch mẫu</PageTitle>
<PageHeader OnRefresh="RefreshAsync" Title="@(detail is null ? "Chi tiết kế hoạch mẫu" : $"{detail.Code} — {detail.Name}")"
            Subtitle="Chi tiết các dòng Thiết bị × Ca × SKU trong mẫu.">
    <Actions>
        <MudButton Href="/production/plan-templates"
                   Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack">Danh sách</MudButton>
        <AuthorizeAction Policy="@Capabilities.ProductionPlanManage">
<MudButton OnClick="@(() => OpenHeaderDialogAsync(false))"
                   Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Edit"
                   Disabled="@(loading || detail is null)">Sửa thông tin</MudButton>
</AuthorizeAction>
        <AuthorizeAction Policy="@Capabilities.ProductionPlanManage">
<MudButton OnClick="@(() => OpenHeaderDialogAsync(true))"
                   Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ContentCopy"
                   Disabled="@(loading || detail is null)">Sao chép</MudButton>
</AuthorizeAction>
        <AuthorizeAction Policy="@Capabilities.ProductionPlanManage">
<MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                   Disabled="@(loading || detail is null || deleting)"
                   OnClick="OpenAddItemsDialogAsync">Thêm dòng</MudButton>
</AuthorizeAction>
    </Actions>
</PageHeader>

@if (!string.IsNullOrWhiteSpace(error))
{
    <MudAlert Dense="true" Class="my-3"
              Severity="Severity.Error" Variant="Variant.Outlined">@error</MudAlert>
}
@if (loading)
{
    <MudProgressLinear Indeterminate="true" Class="mt-3" Color="Color.Primary" />
}
@if (!loading && detail is not null && lookups is not null)
{
    <MudPaper Class="sample-detail-summary mt-3 pa-3" Elevation="0" aria-label="Tổng quan kế hoạch mẫu">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="sample-summary-metrics">
            <MetricCard Label="Dòng kế hoạch" Value="@detail.ItemCount.ToString("N0")" Icon="@Icons.Material.Filled.ListAlt" Color="Color.Info" />
            <MetricCard Label="Thiết bị" Value="@detail.WorkUnitCount.ToString("N0")" Icon="@Icons.Material.Filled.Settings" Color="Color.Info" />
            <MetricCard Label="Ca làm việc" Value="@detail.ShiftCount.ToString("N0")" Icon="@Icons.Material.Filled.Schedule" Color="Color.Info" />
            <MetricCard Label="Tổng SL kế hoạch" Value="@detail.TotalPlannedQuantity.ToString("N0")" Icon="@Icons.Material.Filled.Inventory2" Color="Color.Primary" />
        </MudStack>
        <AuthorizeAction Policy="@Capabilities.ProductionPlanManage">
<MudButton Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteSweep"
                   Disabled="@(selected.Count == 0 || deleting)"
                   OnClick="DeleteSelectedAsync">Xóa đã chọn (@selected.Count)</MudButton>
</AuthorizeAction>
    </MudPaper>
    <MudPaper Class="sample-detail-lines mt-3" Elevation="0">
        <PageTable TItem="SamplePlanItemDetail" @ref="table" ItemsProvider="LoadItems"
                   AriaLabel="Thiết bị trong kế hoạch mẫu" EmptyTitle="Mẫu chưa có dòng thiết bị"
                   Height="max(320px, calc(100dvh - 400px))" FixedHeader="true"
                   Striped="false" RowClassFunc="MachineRowClass"
                   GroupBy="grouping.Definition" GroupHeaderClass="sample-machine-group">
            <ToolbarContent>
                <TableGroupingSelector Value="grouping.Mode" ValueChanged="ChangeGrouping" Disabled="deleting"
                                       ExpandAll="() => table?.ExpandAllGroups()" CollapseAll="() => table?.CollapseAllGroups()" />
            </ToolbarContent>
            <ColGroup>
                @if (grouping.Mode != TableGroupingMode.None) { <col style="width:36px" /> }
                <col style="width:44px" />
                @if (grouping.Mode != TableGroupingMode.Machine) { <col style="width:24%" /> }
                @if (grouping.Mode != TableGroupingMode.Product) { <col style="width:24%" /> }
                <col style="width:20%" />
                <col style="width:16%" />
                <col />
                <col style="width:80px" />
            </ColGroup>
            <HeaderContent>
                <MudTh>
                    <MudStack Row="true" Spacing="0" AlignItems="AlignItems.Center">
                        <MudCheckBox T="bool" Value="@AllVisibleSelected" aria-label="Chọn tất cả dòng đang hiển thị"
                                     Disabled="@(deleting || visibleItems.Count == 0)"
                                     ValueChanged="SelectVisible" />
                    </MudStack>
                </MudTh>
                @if (grouping.Mode != TableGroupingMode.Machine)
                { <MudTh><MudTableSortLabel T="SamplePlanItemDetail" SortLabel="workunit">Máy</MudTableSortLabel></MudTh> }
                @if (grouping.Mode != TableGroupingMode.Product)
                { <MudTh><MudTableSortLabel T="SamplePlanItemDetail" SortLabel="product">Sản phẩm</MudTableSortLabel></MudTh> }
                <MudTh><MudTableSortLabel T="SamplePlanItemDetail" SortLabel="shift">Ca</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel T="SamplePlanItemDetail" SortLabel="quantity">Sản lượng KH</MudTableSortLabel></MudTh>
                <MudTh>Ghi chú</MudTh><MudTh>Thao tác</MudTh>
            </HeaderContent>
            <GroupHeaderTemplate Context="group">
                @{
                    var items = group.Items.ToArray();
                    var key = group.Key as TableGroupKey ?? new TableGroupKey("unknown", "Chưa xác định");
                }
                <MudTd colspan="6">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="1" Class="sample-machine-heading">
                        <MudCheckBox T="bool" Value="@items.All(item => selected.Contains(item.Id))"
                                     aria-label="@($"Chọn nhóm {key.Code}")" Disabled="deleting"
                                     ValueChanged="value => SelectGroup(items, value)" />
                        <MudText Typo="Typo.body2" Class="sample-machine-code">@key.Code</MudText>
                        <MudText Typo="Typo.body2" Class="sample-machine-name">@key.Name</MudText>
                        <MudText Typo="Typo.caption" Class="sample-machine-summary">
                            @items.Length dòng trên trang này · SL KH @items.Sum(item => item.PlannedQuantity).ToString("N0")
                        </MudText>
                    </MudStack>
                </MudTd>
            </GroupHeaderTemplate>
            <RowTemplate Context="item">
                <MudTd>
                    <MudCheckBox T="bool" Value="@selected.Contains(item.Id)" aria-label="@($"Chọn dòng {item.WorkUnit} {item.Shift}")"
                                 Disabled="@deleting"
                                 ValueChanged="value => Toggle(item.Id, value)" />
                </MudTd>
                @if (grouping.Mode != TableGroupingMode.Machine)
                {
                    <MudTd DataLabel="Máy">
                        <MudText Class="sample-item-code" Typo="Typo.body2">@item.WorkUnit</MudText>
                        <MudText Class="mud-text-secondary" Typo="Typo.caption">@item.WorkUnitName</MudText>
                    </MudTd>
                }
                @if (grouping.Mode != TableGroupingMode.Product)
                {
                <MudTd DataLabel="Sản phẩm">
                    <MudText Class="sample-item-code" Typo="Typo.body2">@item.Product</MudText>
                    <MudText Class="mud-text-secondary" Typo="Typo.caption">@item.ProductName</MudText>
                </MudTd>
                }
                <MudTd DataLabel="Ca">
                    <MudText Class="sample-item-code" Typo="Typo.body2">@(item.ShiftName ?? item.Shift)</MudText>
                    @if (item.ShiftStart.HasValue && item.ShiftEnd.HasValue)
                    { <MudText Class="mud-text-secondary" Typo="Typo.caption">@($"{item.ShiftStart:HH:mm}–{item.ShiftEnd:HH:mm}")</MudText> }
                </MudTd>
                <MudTd DataLabel="Sản lượng KH"><MudText Class="sample-item-code" Typo="Typo.body2">@item.PlannedQuantity.ToString("N0")</MudText></MudTd>
                <MudTd DataLabel="Ghi chú">@item.Notes</MudTd>
                <MudTd DataLabel="Thao tác">
                    <AuthorizeAction Policy="@Capabilities.ProductionPlanManage">
                        <RowActionMenu Label="@($"Thao tác {item.WorkUnit} {item.Product} {item.Shift}")">
                            <RowAction Label="Sửa dòng"
                                       Icon="@Icons.Material.Filled.Edit" Color="Color.Primary"
                                       Disabled="@deleting"
                                       OnClick="() => EditItemAsync(item)" />
                            <RowAction Label="Xóa dòng"
                                       Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                       Disabled="@deleting"
                                       OnClick="() => DeleteOneAsync(item)" />
                        </RowActionMenu>
                    </AuthorizeAction>
                </MudTd>
            </RowTemplate>
        </PageTable>
    </MudPaper>
}
