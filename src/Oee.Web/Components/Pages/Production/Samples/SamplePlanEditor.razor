@namespace Oee.Web.Components.Pages.Production
@page "/production/plan-templates/new"
@page "/production/plan-templates/{Id:guid}/edit"
@attribute [Authorize(Policy = Capabilities.ProductionPlanManage)]
@inject IDialogService DialogService
@inject NavigationManager Navigation

<PageTitle>Kế hoạch mẫu</PageTitle>
<MudPaper Elevation="0" Outlined="true" Class="pa-4">
    <MudStack Spacing="2">
        <MudText Typo="Typo.h6">Kế hoạch mẫu</MudText>
        <MudText Typo="Typo.body2">Biểu mẫu được mở trong popup.</MudText>
        <MudButton OnClick="OpenDialogAsync" Variant="Variant.Filled" Color="Color.Primary">Mở popup</MudButton>
    </MudStack>
</MudPaper>
