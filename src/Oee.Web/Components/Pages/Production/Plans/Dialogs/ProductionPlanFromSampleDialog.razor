@namespace Oee.Web.Components.Pages.Production
@using Oee.Application.Contracts.Modules
@using Oee.Application.Contracts.Operations
@inject ProductionPlanCreationRunner Runner
@inject IAuthorizationService Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">Tạo kế hoạch từ mẫu</MudText></TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_formValid">
            <MudStack Spacing="2">
                <MudAlert Severity="Severity.Info" Dense="true">
                    Chọn <MudElement HtmlTag="strong">mẫu kế hoạch</MudElement> và <MudElement HtmlTag="strong">ngày áp dụng</MudElement> để tạo kế hoạch cho từng dòng
                    Thiết bị × Ca × SKU của mẫu. Ca đêm kết thúc sang ngày hôm sau. Tổ hợp trùng được bỏ qua;
                    xung đột không bị ghi đè.
                </MudAlert>
                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
                }
                <MudAutocomplete T="SamplePlanListItem" Label="Mẫu kế hoạch" Value="_selectedSample"
                                 ValueChanged="OnSampleChangedAsync" SearchFunc="SearchSamplesAsync" ToStringFunc="SampleText"
                                 AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" ResetValueOnEmptyText="true"
                                 Required="true" DebounceInterval="250" MaxItems="20" Disabled="_saving" />
                <MudDatePicker Label="Ngày áp dụng" Date="_appliedDate" DateChanged="OnDateChangedAsync"
                               DateFormat="dd/MM/yyyy" Required="true" Disabled="_saving" />
                <MudTextField T="string" Label="Ghi chú chung (tùy chọn)" @bind-Value="_notes" MaxLength="500" Disabled="_saving" />
                @if (_loadingPreview)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                    <MudText Typo="Typo.caption">Đang tải bản xem trước…</MudText>
                }
                @if (_preview is not null)
                {
                    <MudPaper Outlined="true" Elevation="0" Class="pa-2">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">
                            Xem trước — @_preview.ValidCount dòng sẽ được tạo · @_preview.SkippedCount trùng · @_preview.ConflictCount xung đột
                        </MudText>
                        <MudTable T="BulkPlanCombination" Items="@(_preview.Combinations.OrderBy(row => row.WorkUnit, StringComparer.OrdinalIgnoreCase).ThenBy(row => row.StartAt))" Dense="true" Hover="true"
                                  FixedHeader="true" Height="320px" Elevation="0" Breakpoint="Breakpoint.Sm">
                            <HeaderContent>
                                <MudTh>Thiết bị</MudTh><MudTh>Ca</MudTh><MudTh>SKU</MudTh><MudTh>Bắt đầu</MudTh>
                                <MudTh>Kết thúc</MudTh><MudTh>SL KH</MudTh><MudTh>Trạng thái</MudTh>
                            </HeaderContent>
                            <RowTemplate Context="row">
                                <MudTd DataLabel="Thiết bị">@row.WorkUnit</MudTd>
                                <MudTd DataLabel="Ca">@row.Shift</MudTd>
                                <MudTd DataLabel="SKU">@row.Product</MudTd>
                                <MudTd DataLabel="Bắt đầu">@(row.StartAt == default ? "—" : $"{row.StartAt:dd/MM HH:mm}")</MudTd>
                                <MudTd DataLabel="Kết thúc">@(row.EndAt == default ? "—" : $"{row.EndAt:dd/MM HH:mm}")</MudTd>
                                <MudTd DataLabel="SL KH">
                                    @if (row.SourceSamplePlanItemId.HasValue && row.State == "Valid")
                                    {
                                        <MudNumericField T="decimal" Value="row.PlannedQuantity" Min="0.0001m" Format="0.####"
                                                         ValueChanged="value => SetOverride(row, value)" Disabled="_saving" />
                                    }
                                    else
                                    {
                                        @row.PlannedQuantity.ToString("0.####")
                                    }
                                </MudTd>
                                <MudTd DataLabel="Trạng thái">
                                    <StatusChip Text="@StateText(row.State)" Kind="@StateKind(row.State)" />
                                    @if (!string.IsNullOrWhiteSpace(row.Reason))
                                    {
                                        <MudText Typo="Typo.caption">@row.Reason</MudText>
                                    }
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudPaper>
                }
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_saving">Hủy</MudButton>
        <MudButton OnClick="SaveAsync" Disabled="@(!CanSave)" Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.PlaylistAddCheck">
            @if (_saving)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
            }
            Tạo kế hoạch
        </MudButton>
    </DialogActions>
</MudDialog>
