@namespace Oee.Web.Components.Pages

@* Thẻ MudBlazor dùng hook CSS theo trạng thái; dữ liệu do LiveOeeBoard truyền xuống. *@
<MudCard Class="@($"live-machine-card live-machine-card--{CardState} rounded-lg overflow-hidden d-flex flex-column flex-grow-1")" Elevation="1"
         aria-label="@($"Live OEE {Machine.Code}")" data-connectivity="@Machine.ConnectivityState">
    <MudDivider Class="live-machine-status-border" />
    <MudCardContent Class="pa-3 d-flex flex-column flex-grow-1">
        <MudStack Spacing="2" Class="flex-grow-1">
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <MudAvatar Color="Color.Info" Variant="Variant.Text" Size="Size.Small" Class="mud-info-hover">
                        <MudIcon Icon="@Icons.Material.Outlined.PrecisionManufacturing" Color="Color.Info" Size="Size.Medium" />
                    </MudAvatar>
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h5">@Machine.Code</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary" title="@Machine.Name">@Machine.Name</MudText>
                    </MudStack>
                </MudStack>
            </MudStack>

            <MudPaper Elevation="0" Class="live-machine-state pa-2 rounded-lg"
                      data-machine-state="@Machine.OperationalState" data-card-state="@CardState">
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Justify="Justify.Center">
                    <MudIcon Icon="@StateIcon" Size="Size.Small" Color="Color.Inherit" />
                    <MudText Typo="Typo.subtitle2" Color="Color.Inherit">@StateText</MudText>
                </MudStack>
            </MudPaper>

            @if (Machine.IsStale || Machine.IsCounterStalled)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="rounded-lg mud-warning-hover">
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                        <MudText Typo="Typo.caption">@(Machine.IsStale ? "Dữ liệu không cập nhật" : "Bộ đếm chưa thay đổi")</MudText>
                        <MudDivider Vertical="true" FlexItem="true" Class="mud-border-warning" />
                        <MudText Typo="Typo.subtitle2">@Age(Machine.IsStale ? Machine.DataAgeSeconds : Machine.CounterIdleSeconds)</MudText>
                    </MudStack>
                </MudAlert>
            }

            <MudPaper Elevation="0" Outlined="true" Class="live-machine-plan pa-2 rounded-lg mud-info-hover">
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <MudIcon Color="Color.Info" Icon="@(Machine.CurrentPlan is null ? Icons.Material.Outlined.EventNote : Icons.Material.Filled.AssignmentTurnedIn)" />
                    <MudText Typo="Typo.caption">@(Machine.CurrentPlan is null ? "Chưa có kế hoạch đang chạy" : $"Kế hoạch: {Machine.CurrentPlan}")</MudText>
                </MudStack>
            </MudPaper>

            @if (Machine.Oee.HasValue || Machine.CurrentPlan is not null)
            {
                <MudPaper Elevation="0" Outlined="true" Class="pa-2 rounded-lg">
                    <MudGrid Spacing="2">
                        <MudItem xs="3">
                            <MudText Typo="Typo.caption" Color="Color.Inherit" Class="mud-text-secondary">OEE @Machine.ProductionPeriods?.ShiftCode</MudText>
                            <MudText Typo="Typo.h6" Color="@StateColor" data-metric="oee">@Percent(Machine.Oee)</MudText>
                        </MudItem>
                        <MudItem xs="3">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">A</MudText>
                            <MudText Typo="Typo.subtitle2" data-metric="availability">@Percent(Machine.Availability)</MudText>
                        </MudItem>
                        <MudItem xs="3">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">P</MudText>
                            <MudText Typo="Typo.subtitle2" data-metric="performance">@Percent(Machine.Performance)</MudText>
                        </MudItem>
                        <MudItem xs="3">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Q</MudText>
                            <MudText Typo="Typo.subtitle2" data-metric="quality">@Percent(Machine.Quality)</MudText>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            }

            <MudGrid Spacing="2">
                <MudItem xs="7">
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        <MudIcon Icon="@Icons.Material.Outlined.Inventory2" Color="Color.Info" Size="Size.Small" />
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">SKU hiện tại</MudText>
                            <MudText Typo="Typo.subtitle2">@(Machine.CurrentProduct ?? "—")</MudText>
                        </MudStack>
                    </MudStack>
                </MudItem>
                <MudItem xs="5">
                    <MudStack Spacing="0" Class="border-l border-solid mud-border-lines-default pl-3">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">SL SKU này:</MudText>
                        <MudText Typo="Typo.subtitle2">@Number(Machine.ProductionPeriods?.CurrentProductQuantity)</MudText>
                    </MudStack>
                </MudItem>
            </MudGrid>

            <MudGrid Spacing="2">
                <MudItem xs="6" Class="d-flex">
                    <LiveProductionMetric Label="@($"CA {Machine.ProductionPeriods?.ShiftCode ?? "—"}")"
                                          Value="@Machine.ProductionPeriods?.ShiftQuantity" Icon="@Icons.Material.Filled.BarChart" />
                </MudItem>
                <MudItem xs="6" Class="d-flex">
                    <LiveProductionMetric Label="@($"TUẦN {Machine.ProductionPeriods?.WeekNumber}")"
                                          Value="@Machine.ProductionPeriods?.WeekQuantity" Icon="@Icons.Material.Outlined.DateRange" />
                </MudItem>
                <MudItem xs="6" Class="d-flex">
                    <LiveProductionMetric Label="@($"NGÀY {Machine.ProductionPeriods?.LocalDate.ToString("dd/MM")}")"
                                          Value="@Machine.ProductionPeriods?.DayQuantity" Icon="@Icons.Material.Outlined.Today" />
                </MudItem>
                <MudItem xs="6" Class="d-flex">
                    <LiveProductionMetric Label="@($"THÁNG {Machine.ProductionPeriods?.LocalDate.Month}")"
                                          Value="@Machine.ProductionPeriods?.MonthQuantity" Icon="@Icons.Material.Outlined.CalendarMonth" />
                </MudItem>
            </MudGrid>

            <MudPaper Elevation="0" Class="live-counter-bar pa-2 rounded-lg blue-gray darken-3 white-text">
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                        <MudIcon Icon="@Icons.Material.Outlined.Storage" Size="Size.Small" Color="Color.Inherit" />
                        <MudText Typo="Typo.caption" Color="Color.Inherit">Counter đã xử lý</MudText>
                    </MudStack>
                    <MudText Typo="Typo.subtitle2" Color="Color.Inherit" data-metric="plc-counter">@Number(Machine.PlcTotalCounter)</MudText>
                </MudStack>
            </MudPaper>
            <MudStack Row="true" Spacing="1" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap">
                <MudText Typo="Typo.caption" Color="@ConnectivityColor">@ConnectivityText</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Nhận OPC: @(Machine.LastDataAt?.ToLocalTime().ToString("HH:mm:ss") ?? "—")</MudText>
            </MudStack>
            @if (Machine.CounterDiscontinuityPending)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Counter chấp nhận: @(Machine.CounterAcceptedAt?.ToLocalTime().ToString("dd/MM HH:mm:ss") ?? "—")</MudText>
            }
        </MudStack>
    </MudCardContent>
</MudCard>
