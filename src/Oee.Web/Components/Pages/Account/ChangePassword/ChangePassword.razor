@namespace Oee.Web.Components.Pages
@page "/Account/ChangePassword"
@attribute [Authorize]

@* Trang yêu cầu người dùng đã đăng nhập và native POST tới endpoint Identity.
   Endpoint kiểm tra mật khẩu hiện tại, password policy, antiforgery và làm mới authentication cookie;
   mật khẩu/plain hash không được đưa vào audit, response DTO hoặc browser log. *@
<PageTitle>Đổi mật khẩu</PageTitle>

<PageHeader Title="Đổi mật khẩu"
            Subtitle="Mật khẩu được xử lý bởi ASP.NET Identity và không được ghi vào audit hoặc log">
    <Actions>
        <MudButton Href="/"
                   Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack">
            Quay lại Dashboard
        </MudButton>
    </Actions>
</PageHeader>

<MudPaper Class="pa-4 identity-password-card" Elevation="0">
    @if (Success)
    {
        <MudAlert Class="mb-3"
                  Severity="Severity.Success">
            Mật khẩu đã được thay đổi. Phiên đăng nhập hiện tại đã được làm mới an toàn.
        </MudAlert>
    }

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <MudAlert Class="mb-3"
                  Severity="Severity.Error">@ErrorMessage</MudAlert>
    }

    @* Native POST is intentional so Identity can refresh the authentication cookie in an HTTP response. *@
    <form method="post"
          action="/account/change-password"
          data-enhance="false"
          class="identity-password-form">
        <AntiforgeryToken />

        <label for="currentPassword">Mật khẩu hiện tại</label>
        <input id="currentPassword"
               name="currentPassword"
               type="password"
               autocomplete="current-password"
               maxlength="128"
               required />

        <label for="newPassword">Mật khẩu mới</label>
        <input id="newPassword"
               name="newPassword"
               type="password"
               autocomplete="new-password"
               minlength="8"
               maxlength="128"
               required />

        <label for="confirmPassword">Xác nhận mật khẩu mới</label>
        <input id="confirmPassword"
               name="confirmPassword"
               type="password"
               autocomplete="new-password"
               minlength="8"
               maxlength="128"
               required />

        <MudText Typo="Typo.caption">
            Mật khẩu phải đáp ứng chính sách độ dài, chữ hoa, chữ thường, chữ số và ký tự đặc biệt đang cấu hình.
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Password"
                   ButtonType="ButtonType.Submit">
            Đổi mật khẩu
        </MudButton>
    </form>
</MudPaper>
