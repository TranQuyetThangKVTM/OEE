@namespace Oee.Web.Components.Pages
@page "/users"
@page "/account/users"
@using System.Security.Claims
@using Oee.Application.Contracts.Identity
@using Oee.Web.Configuration
@attribute [Authorize]
@inject Oee.Application.Common.IUseCaseExecutor UsersService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject Microsoft.Extensions.Options.IOptions<IdentitySecurityOptions> SecurityOptions
@inject IDialogService DialogService
@inject ISnackbar Snackbar

@* Danh sách ASP.NET Identity yêu cầu đăng nhập; thao tác quản trị giữ capability UsersManage. Search/sort/page phía server
   và DTO không chứa PasswordHash/SecurityStamp. Ẩn/disable action trên UI chỉ là UX; IUserManagementService
   vẫn kiểm tra quyền, tự thao tác, Admin cuối cùng, concurrency và ghi audit đã masking. *@
<PageTitle>Quản lý người dùng</PageTitle>

<PageHeader OnRefresh="ReloadAsync" Title="Quản lý người dùng"
            Subtitle="Tạo tài khoản, gán vai trò, đặt lại mật khẩu và vô hiệu hóa tài khoản.">
    <Actions>
        <AuthorizeAction Policy="@Capabilities.UsersManage">
<MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.PersonAdd"
                   OnClick="CreateAsync">Tạo tài khoản</MudButton>
</AuthorizeAction>
    </Actions>
    <Metrics><MetricCard Label="Tài khoản" Value="@_totalCount.ToString("N0")" Icon="@Icons.Material.Filled.People" Color="Color.Info" /></Metrics>
</PageHeader>

@if (!string.IsNullOrWhiteSpace(_error))
{
    <MudAlert Dense="true" Class="my-3"
              Severity="Severity.Error" Variant="Variant.Outlined">@_error</MudAlert>
}

<PageFilter>
    <MudTextField T="string" @bind-Value="_search" Label="Tìm theo tài khoản, email, tên hiển thị"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                  Immediate="true" DebounceInterval="500"
                  @bind-Value:after="ApplyFiltersAsync" />
    <MudSelect T="string" @bind-Value="_role" Label="Vai trò"
               Clearable="true"
               @bind-Value:after="ApplyFiltersAsync">
        @foreach (var role in _roles)
        {
            <MudSelectItem T="string" Value="@role.Name">@role.Name</MudSelectItem>
        }
    </MudSelect>
    <MudSelect T="string" @bind-Value="_state" Label="Trạng thái"
               Clearable="true"
               @bind-Value:after="ApplyFiltersAsync">
        <MudSelectItem T="string" Value="@("Active")">Bình thường</MudSelectItem>
        <MudSelectItem T="string" Value="@("Locked")">Đang khóa</MudSelectItem>
        <MudSelectItem T="string" Value="@("Disabled")">Đã vô hiệu hóa</MudSelectItem>
    </MudSelect>
</PageFilter>


<PageTable TItem="UserResponse" @ref="_table" ItemsProvider="LoadAsync"
             AriaLabel="Danh sách người dùng" EmptyTitle="Không có tài khoản phù hợp">
    <HeaderContent>
        <MudTh><MudTableSortLabel T="UserResponse" SortLabel="username">Tài khoản</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="UserResponse" SortLabel="displayName">Tên hiển thị</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="UserResponse" SortLabel="email">Email</MudTableSortLabel></MudTh>
        <MudTh>Vai trò</MudTh>
        <MudTh><MudTableSortLabel T="UserResponse" SortLabel="status">Trạng thái</MudTableSortLabel></MudTh>
        <MudTh>Thao tác</MudTh>
    </HeaderContent>
    <RowTemplate Context="user">
        <MudTd DataLabel="Tài khoản"><strong>@user.UserName</strong></MudTd>
        <MudTd DataLabel="Tên hiển thị">@(user.DisplayName ?? "—")</MudTd>
        <MudTd DataLabel="Email">@(user.Email ?? "—")</MudTd>
        <MudTd DataLabel="Vai trò">
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                @foreach (var role in user.Roles) { <StatusChip Text="@role" Kind="@RoleKind(role)" /> }
            </MudStack>
        </MudTd>
        <MudTd DataLabel="Trạng thái"><StatusChip Text="@StateText(user)" Kind="@StateKind(user)" /></MudTd>
        <MudTd DataLabel="Thao tác">
            <AuthorizeAction Policy="@Capabilities.UsersManage">
                <RowActionMenu Label="@($"Thao tác tài khoản {user.UserName}")">
                    <RowAction Label="Chỉnh sửa tài khoản"
                               Icon="@Icons.Material.Filled.Edit"
                               Disabled="@(user.IsDisabled || IsBusy(user))"
                               OnClick="() => EditAsync(user.Id)" />
                    <RowAction Label="Đặt lại mật khẩu"
                               Icon="@Icons.Material.Filled.Password" Color="Color.Secondary"
                               Disabled="@(user.IsDisabled || IsSelf(user) || IsBusy(user))"
                               OnClick="() => ResetPasswordAsync(user)" />
                    <RowAction Label="Vô hiệu hóa tài khoản"
                               Icon="@Icons.Material.Filled.PersonOff" Color="Color.Error"
                               Disabled="@(user.IsDisabled || IsSelf(user) || IsBusy(user))"
                               OnClick="() => DisableAsync(user)" />
                </RowActionMenu>
            </AuthorizeAction>
        </MudTd>
    </RowTemplate>
</PageTable>
