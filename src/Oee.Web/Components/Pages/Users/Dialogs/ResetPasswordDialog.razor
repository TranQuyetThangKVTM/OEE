@namespace Oee.Web.Components.Pages
@using Oee.Application.Contracts.Identity
@inject Oee.Application.Common.IUseCaseExecutor UsersService
@inject ISnackbar Snackbar

@* Dialog quản trị đặt lại mật khẩu qua IUserManagementService/ASP.NET Identity.
   Password chỉ tồn tại trong form/request ngắn hạn, không được trả về, audit hay log;
   backend kiểm tra ManageUsers, policy mật khẩu, RowVersion và làm mới security state phù hợp. *@
<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_valid">
            <MudStack Spacing="2">
                <MudText>Nhập mật khẩu mới cho <strong>@UserName</strong>. Mật khẩu hiện tại sẽ bị thay thế và số lần sai mật khẩu được đặt lại về 0.</MudText>
                <MudTextField T="string" @bind-Value="_password" Label="Mật khẩu mới"
                              InputType="InputType.Password" Required="true" RequiredError="Mật khẩu mới là bắt buộc." MaxLength="128" Immediate="true" />
                <MudText Typo="Typo.caption">@PasswordPolicyText</MudText>
                <MudTextField T="string" @bind-Value="_confirmation" Label="Nhập lại mật khẩu"
                              InputType="InputType.Password" Required="true" RequiredError="Vui lòng nhập lại mật khẩu." Validation="@(new Func<string?, string?>(ValidateConfirmation))" MaxLength="128" Immediate="true" />
                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <MudAlert Severity="Severity.Error">@_error</MudAlert>
                }
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Disabled="_saving"
                   OnClick="Cancel">Hủy</MudButton>
        <MudButton Color="Color.Secondary" Variant="Variant.Filled"
                   Disabled="@(_saving || !CanSubmit)"
                   OnClick="SaveAsync">
            @if (_saving) { <MudProgressCircular Size="Size.Small" Class="me-2"
                                 Indeterminate="true" /> }
            Đặt lại mật khẩu
        </MudButton>
    </DialogActions>
</MudDialog>
